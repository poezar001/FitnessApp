<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_trainer_default">

    <androidx.cardview.widget.CardView
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:cardCornerRadius="35dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/surface">

        <ImageView
            android:id="@+id/ivTrainerAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_trainer_avatar" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvTrainerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Dice"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvTrainerRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Yoga Expert"
        android:textSize="9sp"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Quote - Visible only in For You page (via visibility control) -->
    <TextView
        android:id="@+id/tvTrainerQuote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Find your peace"
        android:textSize="8sp"
        android:textColor="@color/primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@color/surface_light"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Experience - Visible only in For You page (via visibility control) -->
    <TextView
        android:id="@+id/tvTrainerExperience"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="10+ years"
        android:textSize="8sp"
        android:textColor="@color/text_hint"
        android:background="@color/surface"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone" />

    <!-- Selection Indicator - Visible only in Plans page -->
    <View
        android:id="@+id/selectionIndicator"
        android:layout_width="20dp"
        android:layout_height="3dp"
        android:layout_marginTop="4dp"
        android:background="@color/primary"
        android:visibility="gone" />

</LinearLayout>