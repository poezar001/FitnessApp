<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FitnessApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.FitnessApp.Light</item>
    </style>

    <style name="ThemeOverlay.FitnessApp.Light" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
    </style>
</resources>